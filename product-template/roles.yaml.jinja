# Who holds which role (SOP-001 section 3). Procedures name roles, never people.
# One person can hold several roles. When the team changes, update this file through a PR.

people:
  - id: {{ approver_id }}
    name: {{ approver_name }}

roles:
  quality_lead: [{{ approver_id }}]
  approver:
    design: [{{ approver_id }}]
    documents: [{{ approver_id }}]
    release: [{{ approver_id }}]
    nonconformance: [{{ approver_id }}]
  internal_auditor: []     # must not audit their own work; name an outside person

# Agents are authors and reviewers, never approvers.
agents:
  - id: design-agent
    tool: "<e.g. Claude Code / Codex>"
  - id: review-agent
    tool: "<independent session, ideally a different model>"
