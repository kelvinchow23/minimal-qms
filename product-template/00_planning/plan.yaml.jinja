# Development plan (SOP-004 section 4). Change through a PR; old values stay in git history.
involvement: {{ involvement }}   # agent-driven, balanced or human-driven (SOP-004 section 3a)
product: null              # top assembly part number, allocated in the design stage
iteration: 1
qms_rev: "{{ _commit }}"   # the minimalQMS revision this project runs under
goal: ""                   # written at G0
scope:
  in: []
  out: []
make_buy: []               # e.g. {item: enclosure, decision: make, note: "printed in-house"}
roles: roles.yaml
gates:                     # the gates of this involvement level (gates.yaml)
{%- if involvement == 'agent-driven' %}
  - {gate: G2, target: null, actual: null, approval: null}
{%- elif involvement == 'balanced' %}
  - {gate: G1, target: null, actual: null, approval: null}
  - {gate: G2, target: null, actual: null, approval: null}
  - {gate: G3, target: null, actual: null, approval: null}
{%- else %}
  - {gate: G0, target: null, actual: null, approval: null}
  - {gate: G1, target: null, actual: null, approval: null}
  - {gate: G2, target: null, actual: null, approval: null}
  - {gate: G3, target: null, actual: null, approval: null}
  - {gate: G4, target: null, actual: null, approval: null}
{%- endif %}
skipped_gates: []
